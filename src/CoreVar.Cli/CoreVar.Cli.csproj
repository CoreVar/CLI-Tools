<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool><ToolCommandName>corevar</ToolCommandName><PackageId>CoreVar.Cli</PackageId>
    <AssemblyName>corevar</AssemblyName><RootNamespace>CoreVar.Cli</RootNamespace>
    <Title>CoreVar CLI Authoring Tool</Title><Authors>Jeff Scherrer</Authors><Company>CoreVar, LLC</Company>
    <Description>Package, publish, and generate distribution assets for CoreVar command-line applications and modules.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CommandLineInterface\CommandLineInterface.csproj" />
    <ProjectReference Include="..\CommandLineInterface.Publishing\CommandLineInterface.Publishing.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
