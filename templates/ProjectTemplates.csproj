<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.0</PackageVersion>
    <PackageId>CoreVar.CommandLineInterface.Templates</PackageId>
    <Title>CLI Templates</Title>
    <Authors>CoreVar</Authors>
    <Description>Templates to use when creating an CLI apps.</Description>
    <PackageTags>dotnet-new;templates</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\node_modules\**;templates\**\__pycache__\**" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <Target Name="StampTemplatePackageVersions" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <TemplateInput Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/.vs/**;templates/**/node_modules/**;templates/**/__pycache__/**" />
    </ItemGroup>
    <Copy SourceFiles="@(TemplateInput)" DestinationFiles="@(TemplateInput->'$(IntermediateOutputPath)pack-templates/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup><TemplateProject Include="$(IntermediateOutputPath)pack-templates/**/*.csproj" /></ItemGroup>
    <XmlPoke XmlInputPath="%(TemplateProject.Identity)" Query="/Project/ItemGroup/PackageReference[@Include='CoreVar.CommandLineInterface']/@Version" Value="$(PackageVersion)" />
    <ItemGroup>
      <Content Remove="@(Content)" />
      <Content Include="$(IntermediateOutputPath)pack-templates/**/*" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
